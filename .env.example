# ========================================
# E-Waste Management System Configuration
# ========================================
# Copy this file to .env and update the values as needed
# Keep this file secure and never commit .env to version control

# ================
# Core Application
# ================
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here  # Change this to a secure random string

# ================
# Database
# ================
# SQLite (Default)
DATABASE_URL=sqlite:///ewaste.db

# PostgreSQL (Uncomment and configure if using PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost:5432/ewaste_db

# ================
# Authentication & Security
# ================
JWT_SECRET_KEY=your-jwt-secret-key-here  # Change this to a secure random string
JWT_ACCESS_TOKEN_EXPIRES=86400  # 24 hours in seconds
JWT_REFRESH_TOKEN_EXPIRES=2592000  # 30 days in seconds
SESSION_COOKIE_SECURE=False  # Set to True in production with HTTPS
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE='Lax'

# ================
# Email Configuration
# ================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password  # Use app password for Gmail
MAIL_DEFAULT_SENDER=no-reply@ewaste.com
MAIL_DEBUG=False

# ================
# File Uploads
# ================
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216  # 16MB
ALLOWED_EXTENSIONS={'png', 'jpg', 'jpeg', 'gif'}

# ================
# AI/ML Settings
# ================
AI_MODEL=MobileNetV2
AI_TOP_K=5
AI_MODEL_PATH=models/ai_classifier.h5

# ================
# Feature Flags
# ================
ENABLE_AI_SCANNER=True
ENABLE_COMMUNITY_FEED=True
ENABLE_ANALYTICS=True
ENABLE_FEEDBACK=True
ENABLE_EMAIL_VERIFICATION=True
ENABLE_PUSH_NOTIFICATIONS=False

# ================
# PWA Configuration
# ================
PWA_NAME=E-Waste Management System
PWA_SHORT_NAME=E-Waste Manager
PWA_DESCRIPTION=Manage your e-waste and track your environmental impact
PWA_THEME_COLOR=#198754
PWA_BACKGROUND_COLOR=#198754
PWA_DISPLAY=standalone
PWA_SCOPE=/
PWA_ORIENTATION=portrait

# ================
# Logging
# ================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760  # 10MB
LOG_BACKUP_COUNT=5

# ================
# Rate Limiting
# ================
RATELIMIT_DEFAULT=200/hour
RATELIMIT_AUTHENTICATED=1000/hour
RATELIMIT_UPLOADS=50/hour

# ================
# CORS Configuration
# ================
CORS_ORIGINS=*  # In production, replace with your frontend domain
CORS_SUPPORTS_CREDENTIALS=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Mobile Optimization
MOBILE_VIEWPORT_SCALE=1.0
TOUCH_FRIENDLY_UI=True
PWA_ENABLED=True

# Performance Settings
CACHE_TYPE=simple
CACHE_DEFAULT_TIMEOUT=300

# Production Settings (uncomment for production)
# FLASK_ENV=production
# FLASK_DEBUG=False
# SESSION_COOKIE_SECURE=True
# DATABASE_URL=postgresql://user:password@localhost/ewaste_db
